<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_settings"
            android:textSize="22sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/input_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="@string/hint_api_url"
            android:inputType="textUri" />
        <EditText
            android:id="@+id/input_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/hint_token"
            android:inputType="textPassword" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/hint_design"
            android:textStyle="bold" />
        <RadioGroup
            android:id="@+id/design_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/design_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/design_bar" />
            <RadioButton
                android:id="@+id/design_ring"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/design_ring" />
        </RadioGroup>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/hint_title_template"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/input_title_template"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:inputType="text"
            android:typeface="monospace" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/hint_status_template"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/input_status_template"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:inputType="text"
            android:typeface="monospace" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/hint_template"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/input_template"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:typeface="monospace" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/hint_color_title"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/input_color_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="#6DD58A"
            android:inputType="text" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/hint_color_status"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/input_color_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="#6DD58A"
            android:inputType="text" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/hint_color_footer"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/input_color_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="#6DD58A"
            android:inputType="text" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/hint_thickness"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/input_thickness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:inputType="number"
            android:minWidth="96dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/hint_align"
            android:textStyle="bold" />
        <RadioGroup
            android:id="@+id/align_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/align_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/align_left" />
            <RadioButton
                android:id="@+id/align_center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/align_center" />
            <RadioButton
                android:id="@+id/align_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/align_right" />
        </RadioGroup>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/hint_modules"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/input_modules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:minLines="6"
            android:textSize="12sp"
            android:typeface="monospace" />
        <EditText
            android:id="@+id/input_poll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/hint_poll"
            android:inputType="number"
            android:minWidth="96dp" />
        <Button
            android:id="@+id/btn_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/btn_test" />
        <Button
            android:id="@+id/btn_defaults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_defaults" />
        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_save" />
    </LinearLayout>
</ScrollView>